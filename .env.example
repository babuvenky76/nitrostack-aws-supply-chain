# Monorepo env — copy to `.env` in this folder (`module-repos/aws/supply-chain/.env`).
# Put only AWS credentials here. After `terraform apply`, run `npm run tf:write-generated-env` (or
# `npm run provision:aws`) to create `.generated/.env` with public Vite/OIDC vars and the Secrets
# Manager secret *name* (not secret values — those stay encrypted in AWS and are read at runtime via IAM).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-2

# Optional: only if you changed Terraform `project_name` and are not using `.generated/.env`
# SUPPLY_CHAIN_PROJECT_NAME=nsupply

# Optional overrides (normally unnecessary)
# SUPPLY_CHAIN_APP_SECRET_ARN=
# SUPPLY_CHAIN_APP_SECRET_NAME=

# --- Seed: optional explicit table names (otherwise read from Secrets Manager JSON) ---
# PRODUCTS_TABLE_NAME=
# INVENTORY_TABLE_NAME=
